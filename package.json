{
  "name": "baby-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute baby-tracker-db --local --file=worker/db/schema.sql",
    "db:init:remote": "wrangler d1 execute baby-tracker-db --file=worker/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute baby-tracker-db --file=worker/db/migrations/0001_add_ai_memories.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "sharp": "^0.34.5",
    "typescript": "^5.5.0",
    "wrangler": "^3.60.0"
  },
  "dependencies": {
    "hono": "^4.4.0"
  }
}
