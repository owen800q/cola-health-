{
  "name": "baby-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute baby-tracker-db --local --file=worker/db/schema.sql",
    "db:init:remote": "wrangler d1 execute baby-tracker-db --file=worker/db/schema.sql",
    "build:ocr": "cd ocr-wasm && cargo build --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/oar_ocr_rec_wasm.wasm ../worker/ocr/oar_ocr_rec.wasm",
    "test:ocr-model": "mkdir -p tests/.cache && curl -fL -o tests/.cache/PP-OCRv6_small_rec.tar https://pub-652eda747fa24c5581cc69125497b255.r2.dev/PP-OCRv6_small_rec.tar",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "esbuild": "0.17.19",
    "miniflare": "3.20250718.3",
    "sharp": "^0.34.5",
    "typescript": "^5.5.0",
    "wrangler": "^3.60.0"
  },
  "dependencies": {
    "hono": "^4.4.0"
  }
}
